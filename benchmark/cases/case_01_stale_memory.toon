# Case 01: stale memory overrides newer tool result
case_id: case_01
task: Refund order 102, not the newest order
expected_failure_class: stale_context
expected_step: 4
injected_fault: stale memory says order 101 is latest
events:
  - step: 1
    type: system
    content: You are a refund assistant. Memory: order 101 is newest.
  - step: 2
    type: user
    content: Refund order 102
  - step: 3
    type: tool_result
    name: get_orders
    content:
      orders:
        - id: 102
          created_at: 2026-08-20
        - id: 101
          created_at: 2026-08-21
  - step: 4
    type: assistant
    content: Selecting order 101 (newest)
  - step: 5
    type: tool_call
    name: refund_order
    content:
      order_id: 101
assertion:
  path: selected_order
  equals: 102
recorded_tool_outputs:
  get_orders:
    orders:
      - id: 102
        created_at: 2026-08-20
      - id: 101
        created_at: 2026-08-21
