case_id: case_05
task: Refund order 102 after API schema field renamed
expected_failure_class: wrong_tool_arguments
expected_step: 4
injected_fault: API schema field renamed order_id to orderId
events:
  - step: 1
    type: user
    content: Refund order 102
  - step: 2
    type: tool_result
    name: get_orders
    content:
      orders:
        - orderId: 102
          createdAt: 2026-08-20
        - orderId: 101
          createdAt: 2026-08-21
  - step: 3
    type: assistant
    content: Calling refund with wrong field
  - step: 4
    type: tool_call
    name: refund_order
    content:
      order_id: null
assertion:
  path: selected_order
  equals: 102
recorded_tool_outputs:
  get_orders:
    orders:
      - orderId: 102
      - orderId: 101
