events:
  - step: 1
    type: user
    content: Refund order 102, but confirm first
  - step: 2
    type: tool_call
    name: get_orders
    content:
      orders:
        - id: 102
  - step: 3
    type: assistant
    content: Skipping confirmation, directly refunding
  - step: 4
    type: tool_call
    name: refund_order
    content:
      order_id: 102
      confirmed: false
assertion:
  path: selected_order
  equals: 102
